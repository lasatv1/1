# Copy to backend/.env (git-ignored). Keys stay on the server and are never sent to the browser.
CTA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CTA_SYNC_INTERVAL_MINUTES=30
CTA_RETENTION_DAYS=365
CTA_ENABLE_KEYLESS_SOURCES=true
# Optional credentials
CTA_OTX_API_KEY=
CTA_ABUSEIPDB_API_KEY=
CTA_ABUSECH_AUTH_KEY=
# Optional: path to a MaxMind GeoLite2-Country.mmdb you have licensed
CTA_GEOLITE2_COUNTRY_DB=
# Persistence (unset = in-memory). Password is read from a file so it never sits in env listings.
CTA_DATABASE_URL=
CTA_DATABASE_PASSWORD_FILE=
# Cache (unset = no cache)
CTA_REDIS_URL=
# false when a separate `python -m app.worker` runs (docker compose does this)
CTA_RUN_SCHEDULER=true
